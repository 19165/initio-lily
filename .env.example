# Todoist API Key (Get from Settings > Integrations > Developer)
TODOIST_API_KEY=your_todoist_api_key_here

# Tavily API Key (Get free key from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Ollama Configuration
OLLAMA_MODEL=gemma4:cloud
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL Configuration (Matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=lily_db
POSTGRES_USER=lily_user
POSTGRES_PASSWORD=lily_secret

# Memory & Session Settings
MEMORY_WINDOW_SIZE=12
DEFAULT_SESSION_ID=default
